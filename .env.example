# --- App ---
ENV=local
DEBUG=true

# --- Database (async for API, sync for Alembic/Celery) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/workforce
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@db:5432/workforce

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT ---
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTUP=price_...
STRIPE_PRICE_MID=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# --- Firebase ---
FIREBASE_CREDENTIALS_PATH=/app/firebase-service-account.json

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Uploads ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10
